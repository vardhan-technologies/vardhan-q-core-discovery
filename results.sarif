{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Vardhan Q-Core",
          "version": "0.1.0",
          "informationUri": "https://github.com/vardhan/qcore",
          "rules": [
            {
              "id": "DEP-CRYPTO-LIB",
              "name": "Cryptographic library detected: golang.org/x/crypto (SUPPORTED)",
              "shortDescription": {
                "text": "Cryptographic library detected: golang.org/x/crypto (SUPPORTED)"
              },
              "fullDescription": {
                "text": "Dependency golang.org/x/crypto version v0.24.0 identified. PQC Support: SUPPORTED. Algorithms provided: [RSA ECDSA Ed25519 ChaCha20Poly1305 ML-KEM-768]"
              },
              "help": {
                "text": "Library already includes post-quantum cryptography support. Ensure PQC algorithms (e.g. ML-KEM, ML-DSA) are configured."
              },
              "helpUri": "https://csrc.nist.gov/projects/post-quantum-cryptography",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "quantum-ready-pqc"
                ],
                "precision": "high",
                "problem": {
                  "severity": ""
                }
              }
            },
            {
              "id": "go-pqc-hybrid-x25519mlkem",
              "name": "Use of X25519MLKEM768 (quantum-ready-pqc)",
              "shortDescription": {
                "text": "Use of X25519MLKEM768 (quantum-ready-pqc)"
              },
              "fullDescription": {
                "text": "Hybrid Post-Quantum Key Exchange (X25519 + ML-KEM-768) detected. Provides defense-in-depth against both classical and quantum adversaries.\n"
              },
              "help": {
                "text": "Verified hybrid implementation."
              },
              "helpUri": "https://csrc.nist.gov/projects/post-quantum-cryptography",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "quantum-ready-pqc"
                ],
                "precision": "high",
                "problem": {
                  "severity": ""
                }
              }
            },
            {
              "id": "go-rsa-keygen",
              "name": "Use of RSA (quantum-vulnerable-public-key)",
              "shortDescription": {
                "text": "Use of RSA (quantum-vulnerable-public-key)"
              },
              "fullDescription": {
                "text": "RSA key generation detected. RSA is vulnerable to Shor's algorithm at any key size. Plan migration to a hybrid or PQC digital signature (ML-DSA / FIPS 204) or KEM (ML-KEM / FIPS 203).\n"
              },
              "help": {
                "text": "Migrate to ML-DSA (FIPS 204) for digital signatures or ML-KEM (FIPS 203) for key establishment."
              },
              "helpUri": "https://csrc.nist.gov/projects/post-quantum-cryptography",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
